{
  "name": "faim-og-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bundle-size": "wrangler deploy --dry-run --outdir=dist && echo '--- Raw size ---' && du -sh dist"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
