{
  "name": "faim-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "build": "npm run prepare:embeddings && wrangler deploy --dry-run",
    "test": "npm run prepare:embeddings && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run prepare:embeddings && tsc --noEmit",
    "prepare:embeddings": "mkdir -p src/generated && (test -f src/generated/embeddings.json || echo '{}' > src/generated/embeddings.json)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^4.20260426.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.86.0"
  }
}
